{
  "//": "Copy this file to appsettings.Development.json (git-ignored) and fill in real values, or use `dotnet user-secrets`.",
  "ConnectionStrings": {
    "DbConnection": "mongodb://localhost:27017/accountflow"
  },
  "AppSettings": {
    "Token": "REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_BYTES",
    "Issuer": "AccountFlowIssuer",
    "Audience": "AccountFlowAudience",
    "ApiBaseUrl": "http://localhost:7088",
    "FrontendUrl": "http://localhost:5173"
  },
  "Auth": {
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7,
    "VerificationCodeMinutes": 15,
    "ResetCodeMinutes": 15,
    "VerificationCodeLength": 8,
    "RefreshTokenBytes": 32,
    "SendVerificationEmails": true
  },
  "GmailOptions": {
    "Host": "smtp.gmail.com",
    "SmtpPort": 587,
    "Email": "<your-gmail-address>",
    "Password": "<your-gmail-app-password>"
  }
}
